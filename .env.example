DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
# 可选：默认 LLM 提供商 deepseek | qwen（Dashboard 侧边栏可单独切换；qwen 固定 qwen3.8-max）
# AGENTIC_BI_LLM_PROVIDER=deepseek
# 可选：百炼 OpenAI 兼容接口（默认国内）
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 可选：CLI 默认是否开启思考模式（Dashboard 侧边栏可单独切换）
# AGENTIC_BI_LLM_THINKING_ENABLED=false
# DEEPSEEK_THINKING_ENABLED=false

# 可选：LLM 客户端超时（秒）与传输层重试次数（不含 SQL schema 业务重试）
# AGENTIC_BI_LLM_TIMEOUT=60
# AGENTIC_BI_LLM_MAX_RETRIES=2

# 可选：LangSmith 追踪（与 HAR / 会话 JSON 互补，不替换）
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=

AGENTIC_BI_DB_HOST=
AGENTIC_BI_DB_PORT=
AGENTIC_BI_DB_NAME=
AGENTIC_BI_DB_USER=
AGENTIC_BI_DB_PASSWORD=
