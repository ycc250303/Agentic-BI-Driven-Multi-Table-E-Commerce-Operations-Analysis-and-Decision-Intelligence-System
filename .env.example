# =============================================================================
# Application
# =============================================================================

AGENTIC_BI_ENV=dev
AGENTIC_BI_CONFIG_DIR=config
AGENTIC_BI_ARTIFACT_DIR=runtime/artifacts

# =============================================================================
# LLM
# =============================================================================

# deepseek | qwen
AGENTIC_BI_LLM_PROVIDER=deepseek

# 第一阶段每个 provider 只配置一个模型。真实实验表明不同角色需要不同模型时再拆。
AGENTIC_BI_DEEPSEEK_MODEL=deepseek-v4-flash
AGENTIC_BI_QWEN_MODEL=qwen3.8-max

# 客户端只处理瞬时传输错误。
# SQL/schema 业务修复由 LangGraph 控制，不在客户端无限重试。
AGENTIC_BI_LLM_TIMEOUT=60
AGENTIC_BI_LLM_MAX_RETRIES=1

# 结构化步骤固定关闭思考。
# 自由文本步骤是否开启思考由该变量控制。
AGENTIC_BI_LLM_THINKING_ENABLED=false

DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# =============================================================================
# MySQL
# =============================================================================

AGENTIC_BI_DB_HOST=127.0.0.1
AGENTIC_BI_DB_PORT=3306
AGENTIC_BI_DB_NAME=olist

# 在线查数只能使用只读账号
AGENTIC_BI_DB_READONLY_USER=
AGENTIC_BI_DB_READONLY_PASSWORD=

# 维护账号仍由 setup 工具使用，在线 Agent 不得回退到该账号
AGENTIC_BI_DB_USER=
AGENTIC_BI_DB_PASSWORD=

AGENTIC_BI_DB_POOL_SIZE=5
AGENTIC_BI_DB_MAX_OVERFLOW=5
AGENTIC_BI_DB_POOL_RECYCLE_SECONDS=1800
AGENTIC_BI_DB_CONNECT_TIMEOUT_SECONDS=5

# =============================================================================
# SQL policy
# =============================================================================

AGENTIC_BI_SQL_TIMEOUT_MS=10000
AGENTIC_BI_SQL_MAX_ROWS=5000
AGENTIC_BI_SQL_MAX_RESULT_BYTES=10485760
AGENTIC_BI_SQL_MAX_REPAIR_ATTEMPTS=2

# =============================================================================
# LangSmith
# =============================================================================

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-bi

# API Key 关联多个 workspace 时再填写
LANGSMITH_WORKSPACE_ID=

# 仅非 US 区域填写；URL 不要以 / 结尾
LANGSMITH_ENDPOINT=
