    {
      "id": "general-07",
      "split": "general",
      "question": "RJ 州已送达订单的平均配送天数是多少？",
      "bucket": "raw",
      "expected_views": [],
      "required_literals": ["RJ"],
      "intents": [
        {
          "id": "rj_avg_delivery_days",
          "compare": "scalar",
          "key_columns": ["avg_delivery_days"],
          "gold_sql": "SELECT AVG(DATEDIFF(`o`.`order_delivered_customer_date`, `o`.`order_purchase_timestamp`)) AS `avg_delivery_days` FROM `orders` `o` INNER JOIN `customers` `c` ON `o`.`customer_id` = `c`.`customer_id` WHERE `c`.`customer_state` = 'RJ' AND `o`.`order_status` = 'delivered' AND `o`.`order_delivered_customer_date` IS NOT NULL"
        }
      ]
