  "cases": [
    {
      "id": "general-01",
      "split": "general",
      "question": "2017 年 SP 州的销售额是多少？",
      "bucket": "view",
      "expected_views": ["mv_state_sales"],
      "required_literals": ["2017", "SP"],
      "intents": [
        {
          "id": "sp_gmv_2017",
          "compare": "scalar",
          "key_columns": ["total_gmv"],
          "gold_sql": "SELECT SUM(`total_gmv`) AS `total_gmv` FROM `mv_state_sales` WHERE `sales_month` LIKE '2017-%' AND `customer_state` = 'SP'"
        }
      ]
    },
    {
      "id": "general-02",
      "split": "general",
      "question": "2018 年各州销售额排名 TOP10。",
      "bucket": "view",
      "expected_views": ["mv_state_sales"],
      "required_literals": ["2018"],
      "intents": [
        {
          "id": "state_gmv_2018_top10",
          "compare": "ordered_topk",
          "k": 10,
          "key_columns": ["customer_state"],
          "gold_sql": "SELECT `customer_state` FROM `mv_state_sales` WHERE `sales_month` LIKE '2018-%' GROUP BY `customer_state` ORDER BY SUM(`total_gmv`) DESC LIMIT 10"
        }
      ]
